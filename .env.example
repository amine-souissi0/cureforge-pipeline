# Copy this to .env and fill in real values before running docker compose up

# --- Database ---
# Set automatically by docker-compose for containerized services.
# Override here only if running the app outside Docker.
DATABASE_URL=postgresql+asyncpg://cureforge:cureforge@localhost:5432/cureforge

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- API Authentication ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-me

# --- Claude API ---
# Production: pull from AWS Secrets Manager / GCP Secret Manager instead
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail OAuth ---
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_TOKEN_FILE=config/google_token.json
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
# Production alternative: paste the full token JSON here instead of mounting a file
# GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...",...}

# --- Google Cloud (for Pub/Sub setup) ---
GCP_PROJECT_ID=your-gcp-project-id
WEBHOOK_URL=https://your-domain.com

# --- Logging ---
LOG_LEVEL=INFO

# --- GitHub (task sandbox repos) ---
GITHUB_TOKEN=ghp_...
GITHUB_ORG=cureforge-sandbox
